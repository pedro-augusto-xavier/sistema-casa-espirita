# Copie este arquivo para .env e preencha os valores reais.
# O .env NUNCA vai para o Git (está no .gitignore).

# --- Banco de dados ---
# Formato: postgresql+psycopg://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql+psycopg://postgres:SUA_SENHA_AQUI@localhost:5432/casa_espirita

# --- Segurança (JWT) ---
# Gere uma chave aleatória. Ex. no PowerShell:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Criptografia de CPF, observações e anexos ---
# Em desenvolvimento pode deixar comentado (usa chaves de exemplo).
# Em produção é obrigatório -- gere com: python -m scripts.gerar_chaves
# CHAVES_CRIPTOGRAFIA=1:...
# CHAVE_HMAC=...

# --- Verificação em duas etapas: admin | todos | ninguem ---
# MFA_OBRIGATORIO=admin

# --- App ---
APP_ENV=dev

# --- IP de quem acessa (limite de tentativas no login e auditoria) ---
# Cabeçalho que o proxy da frente preenche com o IP real. No Render é o da
# Cloudflare (padrão, não precisa definir). Vazio = sem proxy, vale o IP da
# conexão (aí rode o uvicorn sem --forwarded-allow-ips='*').
# IP_CLIENTE_CABECALHO=cf-connecting-ip
