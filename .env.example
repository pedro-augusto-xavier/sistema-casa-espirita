# Copie este arquivo para .env e preencha os valores reais.
# O .env NUNCA vai para o Git (está no .gitignore).

# --- Banco de dados ---
# Formato: postgresql+psycopg://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql+psycopg://postgres:SUA_SENHA_AQUI@localhost:5432/casa_espirita

# --- Segurança (JWT) ---
# Gere uma chave aleatória. Ex. no PowerShell:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- App ---
APP_ENV=dev
